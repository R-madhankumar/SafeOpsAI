# Copy this to .env and adjust values before running locally (no Docker required).
# All services are expected on localhost with these defaults.

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safeopsdb
DB_USER=safeops
DB_PASS=safeops123

# Grafana admin password (only needed if running Grafana)
GRAFANA_ADMIN_PASS=safeops123

# Ollama — local installation expected at default port
# Change to http://ollama:11434 if running inside Docker Compose
OLLAMA_HOST=http://localhost:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Prometheus (local binary or Docker)
PROMETHEUS_URL=http://localhost:9090

# Agent ports (default values — only change if you have port conflicts)
INCIDENT_AGENT_PORT=8001
RCA_AGENT_PORT=8002
SCORING_AGENT_PORT=8003
COORDINATOR_AGENT_PORT=8004
SANDBOX_AGENT_PORT=8005
REMEDIATION_AGENT_PORT=8006
